PORT=3001
DATABASE_URL=postgresql://elm:elm@localhost:5432/elm_platform?schema=public
REDIS_URL=redis://localhost:6379

# RS256 key pair for access tokens (generate: openssl genrsa -out private.pem 2048
# && openssl rsa -in private.pem -pubout -out public.pem). Paste PEM contents with
# literal \n for newlines when set as a single-line env var.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# HS256 secret for short-lived MFA challenge tokens (openssl rand -hex 32)
MFA_CHALLENGE_SECRET=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
